/**
 * GC write barrier for concurrent collectors.
 *
 * With `-preview=gcbarrier`, after each store of a pointer to memory that is not a
 * local variable, a call tells the collector which memory was written:
 *
 * ---
 * *p = q;                  =>  *p = q; _d_gcBarrier(p);
 * *dst = src;  (struct)    =>  *dst = src; _d_gcBarrierRange(dst, S.sizeof);
 * memcpy(dst, src, n);     =>  memcpy(dst, src, n); _d_gcBarrierRange(dst, n);
 * ---
 *
 * The functions are in druntime (`core.internal.gc.cardbarrier`). The collector
 * rescans what they report, so a pointer stored into an object it has already
 * scanned is not lost. It is the same barrier as LDC's `-gc-card-marking`
 * (an LLVM pass), and uses the same card table, so that one collector serves both.
 *
 * It is a pass over the backend's element trees, not a rewrite of the frontend's
 * assignments, on purpose: much of what stores pointers never exists as an
 * assignment expression. The code generator itself stores the elements of an array
 * literal into the memory `_d_arrayliteralTX` returned, the fields of a struct
 * literal, the captured variables of a closure. Every store the code generator
 * makes is an `OPeq`, `OPstreq` or `OPmemcpy` here.
 *
 * What it does not see: stores made by inline assembly, by C functions
 * (`memcpy` called as a function rather than generated by the compiler), and
 * through `core.atomic`'s assembly. Those are handled in druntime's source or are
 * the documented limit of the barrier.
 *
 * Compiler implementation of the
 * $(LINK2 https://www.dlang.org, D programming language).
 *
 * Copyright:   Copyright (C) 2026 by The D Language Foundation, All Rights Reserved
 * License:     $(LINK2 https://www.boost.org/LICENSE_1_0.txt, Boost License 1.0)
 * Source:      $(LINK2 https://github.com/dlang/dmd/blob/master/compiler/src/dmd/backend/gcbarrier.d, backend/gcbarrier.d)
 */

module dmd.backend.gcbarrier;

import core.stdc.string : strncmp;

import dmd.backend.cc;
import dmd.backend.blockopt : block_pred;
import dmd.backend.cdef;
import dmd.backend.el;
import dmd.backend.global;
import dmd.backend.oper;
import dmd.backend.rtlsym;
import dmd.backend.symbol;
import dmd.backend.ty;
import dmd.backend.type;

nothrow:

/// Set by `backend_init` from `-preview=gcbarrier`.
__gshared bool gcBarrierEnabled;

/// Largest constant-size copy whose barrier is expanded in place (it spans at most two 512-byte cards).
enum maxInlineRange = 512;

/**
 * Add the barrier to a function's blocks.
 * Called before the backend lowers the elements, so that the elements it adds
 * (the calls, and the temporaries `el_same` makes) are lowered like all others.
 * Params:
 *      sfunc = the function
 *      startblock = its first block
 */
@trusted
void gcBarrierFunction(Symbol* sfunc, block* startblock)
{
    if (!gcBarrierEnabled || isCollectorCode(sfunc.Sident.ptr))
        return;

    clusterBlocks(startblock);

    for (block* b = startblock; b; b = b.Bnext)
    {
        if (b.Belem)
            b.Belem = walk(b.Belem, valueUsed(b.bc));
    }
}

private:

/**
 * The collector and its synchronization are not instrumented: they store into
 * their own metadata, never into the memory the collector manages.
 * (Their mangled names: modules d.gc, d.sync, symgc.*, core.thread.symthread.)
 */
@trusted
bool isCollectorCode(const(char)* name)
{
    static bool starts(const(char)* s, string prefix)
    {
        return strncmp(s, prefix.ptr, prefix.length) == 0;
    }

    return starts(name, "_D1d2gc") || starts(name, "_D1d4sync") ||
           starts(name, "_D5symgc") || starts(name, "_D4core6thread9symthread");
}

/// Does the block's code use the value of its last expression?
bool valueUsed(BC bc) @safe
{
    return !(bc == BC.goto_ || bc == BC.ret || bc == BC.none);
}

/**
 * Walk an element tree, adding the barrier after each store.
 * Params:
 *      e = root of the tree
 *      used = is the value of `e` used by its parent?
 * Returns:
 *      the tree, with e possibly replaced
 */
@trusted
elem* walk(elem* e, bool used)
{
    const op = e.Eoper;

    if (OTbinary(op))
    {
        switch (op)
        {
            case OPcomma:
                clusterChain(e, used);
                e.E1 = walk(e.E1, false);
                e.E2 = walk(e.E2, used);
                break;

            case OPcond:
                e.E1 = walk(e.E1, true);
                e.E2 = walk(e.E2, used);        // the OPcolon
                break;

            case OPcolon:
            case OPcolon2:
                e.E1 = walk(e.E1, used);
                e.E2 = walk(e.E2, used);
                break;

            case OPandand:
            case OPoror:
                e.E1 = walk(e.E1, true);
                e.E2 = walk(e.E2, used);
                break;

            default:
                e.E1 = walk(e.E1, true);
                e.E2 = walk(e.E2, true);
                break;
        }

        // A store whose value nobody uses became a void expression: say so,
        // so that no parent claims a value it does not have.
        if (!used && (op == OPcomma || op == OPcolon || op == OPcolon2 || op == OPcond))
            retypeVoid(e);
    }
    else if (OTunary(op))
    {
        e.E1 = walk(e.E1, true);
    }

    switch (op)
    {
        case OPeq:
        case OPstreq:
        case OPmemcpy:
            return store(e, used);

        default:
            return e;
    }
}

/// `e` is a comma, colon or conditional whose value is unused and whose
/// last operand is now void.
@trusted
void retypeVoid(elem* e)
{
    if (tybasic(e.Ety) == TYvoid || e.ET)
        return;

    elem* last = e.E2;
    if (e.Eoper == OPcond && last.Eoper == OPcolon)
    {
        // `c ? a : b`: void if both arms are
        if (tybasic(last.E1.Ety) == TYvoid && tybasic(last.E2.Ety) == TYvoid)
            e.Ety = TYvoid;
        return;
    }

    if (e.Eoper == OPcolon || e.Eoper == OPcolon2)
    {
        if (tybasic(e.E1.Ety) == TYvoid && tybasic(e.E2.Ety) == TYvoid)
            e.Ety = TYvoid;
        return;
    }

    if (tybasic(last.Ety) == TYvoid)
        e.Ety = TYvoid;
}

/**
 * Is this the address of a variable of the function or a global? Those are
 * not in the memory the collector manages: the stack and the data segment
 * are scanned as roots.
 */
@trusted
bool isVariableAddress(elem* a)
{
    switch (a.Eoper)
    {
        case OPrelconst:
            return true;

        case OPaddr:
            // &variable (the optimizer turns it into OPrelconst later); &*p is p
            return a.E1.Eoper == OPvar || (a.E1.Eoper == OPind && isVariableAddress(a.E1.E1));

        case OPvar:
            /* With position independent code a global is reached through the GOT:
             * the code generator makes `g = v` into `*(var g) = v`, where `var g`
             * is the address of g. In code that is not position independent the
             * same tree is the dereference of the pointer g holds, which does
             * need the barrier, so this only holds for PIC and PIE.
             */
            if (!(config.flags3 & (CFG3pic | CFG3pie)))
                return false;

            switch (a.Vsym.Sclass)
            {
                case SC.global:
                case SC.static_:
                case SC.locstat:
                case SC.comdat:
                case SC.comdef:
                case SC.extern_:
                    return true;

                default:
                    return false;
            }

        case OPadd:
            // base + offset, in either order: the base is the pointer operand
            return isVariableAddress(a.E1) || isVariableAddress(a.E2);

        case OPmin:
            return isVariableAddress(a.E1);

        default:
            return false;
    }
}

/**
 * Stores of pointers to fields of one object that follow each other
 * (`a.next = x; a.other = y; a.prev = z;`) share one barrier. Statements are
 * the elements of a chain of commas; a run of them that
 *  - store a pointer through the same variable `base`, at `base + constant`,
 *  - with values that have no side effects (nothing between the stores can
 *    change `base` or call the collector), and
 *  - lie within 511 bytes of each other (so two adjacent cards cover them),
 * gets one barrier for the lowest and the highest address, after the last of
 * them. Like the LDC pass, this assumes the stores themselves do not change
 * the variable `base` (that would take a pointer to the variable inside the
 * object it points to).
 */
struct Member
{
    elem** slot;        // where the store is in the tree
    long offset;
}

@trusted
void collectStatements(elem** pe, ref elem**[] list)
{
    elem* e = *pe;
    if (e.Eoper == OPcomma)
    {
        collectStatements(&e.E1, list);
        collectStatements(&e.E2, list);
    }
    else
        list ~= pe;
}

/// Is `*pe` a store that can join a cluster? Sets `base` and `offset`.
@trusted
bool clusterable(elem* e, out elem* base, out long offset)
{
    if (e.Eoper != OPeq || (e.Eflags & (EFLAGS_ptrfree | EFLAGS_gcdone)))
        return false;
    if (!typtr(tybasic(e.Ety)))
        return false;

    elem* lhs = e.E1;
    if (lhs.Eoper != OPind || isVariableAddress(lhs.E1))
        return false;
    if (e.E2.Eoper == OPconst && el_tolong(e.E2) == 0)
        return false;                   // null: no barrier at all
    if (el_sideeffect(e.E2))
        return false;

    elem* a = lhs.E1;
    offset = 0;
    if (a.Eoper == OPadd && a.E2.Eoper == OPconst)
    {
        offset = el_tolong(a.E2);
        a = a.E1;
    }
    if (a.Eoper != OPvar || !typtr(tybasic(a.Ety)))
        return false;
    base = a;
    return true;
}

@trusted
void clusterChain(elem* top, bool used)
{
    elem**[] list;
    collectStatements(&top, list);
    // `top` itself is a comma, so the list is made of its parts
    if (list.length < 2)
        return;

    // The value of the whole chain is its last statement: leave it alone.
    clusterList(list, list.length - (used ? 1 : 0));
}

/**
 * Before the optimizer runs, each statement is a block of its own, joined to
 * the next by a goto. Cluster across a run of such blocks: each continues into
 * the next, which nothing else jumps to.
 */
@trusted
void clusterBlocks(block* startblock)
{
    block_pred(startblock);

    for (block* b = startblock; b; )
    {
        elem**[] list;
        block* last = b;
        for (;;)
        {
            if (last.Belem)
                collectStatements(&last.Belem, list);
            if (last.bc != BC.goto_ || !last.Bnext || last.Bsucc.length != 1 ||
                last.Bsucc[0] != last.Bnext || last.Bnext.Bpred.length != 1)
                break;
            last = last.Bnext;
        }

        // the value of the last block's expression is used if its branch needs one
        const lastUsed = last.Belem && valueUsed(last.bc);
        if (list.length >= 2)
            clusterList(list, list.length - (lastUsed ? 1 : 0));
        b = last.Bnext;
    }
}

@trusted
void clusterList(elem**[] list, size_t n)
{
    size_t i = 0;
    while (i < n)
    {
        elem* base;
        long off;
        if (!clusterable(*list[i], base, off))
        {
            i++;
            continue;
        }

        long lo = off, hi = off;
        size_t members = 1;
        size_t lastMember = i;
        size_t j = i + 1;
        while (j < n)
        {
            elem* b2;
            long o2;
            if (clusterable(*list[j], b2, o2))
            {
                const newLo = o2 < lo ? o2 : lo;
                const newHi = o2 > hi ? o2 : hi;
                if (!el_match(base, b2) || newHi - newLo > 511)
                    break;
                lo = newLo;
                hi = newHi;
                members++;
                lastMember = j;
            }
            else if (el_sideeffect(*list[j]))
                break;          // a call, a store of something else: the run ends
            // else a plain read (the front end re-reads the value it stored): the run goes on
            j++;
        }

        // Two stores to different fields cost as much with one barrier for the
        // pair as with two (the pair needs a second card test): three or more
        // are where sharing pays.
        if (members >= 3 || (members == 2 && lo == hi))
        {
            // only the statements that are members, not the reads between them
            for (size_t k = i; k <= lastMember; k++)
            {
                elem* b3;
                long o3;
                if (clusterable(*list[k], b3, o3))
                    (*list[k]).Eflags |= EFLAGS_gcdone;
            }

            elem* a = el_copytree(base);
            if (lo != 0)
                a = el_bin(OPadd, a.Ety, a, el_long(TYsize_t, lo));
            elem* barrier = lo == hi ? inlineBarrier(a) : inlineBarrierSpan(a, hi - lo);
            elem** last = list[lastMember];
            *last = el_combine(*last, barrier);
        }
        i = lastMember + 1;
    }
}

/**
 * The barrier for stores into [addr, addr + span], span < 512: the card of
 * addr and, if the span reaches into the next one, that one.
 * Params:
 *      addr = lowest address stored to (consumed)
 *      span = distance to the highest, in bytes
 */
@trusted
elem* inlineBarrierSpan(elem* addr, long span)
{
    addr.Ety = TYullong;
    elem* rel = el_bin(OPmin, TYullong, addr, el_var(getRtlsym(RTLSYM.GCCARDLO)));
    elem* rel2 = el_same(rel);                  // rel = (r = addr - lo)
    elem* idx = el_bin(OPshr, TYullong, rel, el_long(TYint, 9));
    elem* idx2 = el_same(idx);
    elem* idx3 = el_copytree(idx2);

    elem* first = el_bin(OPandand, TYint,
        el_bin(OPlt, TYint, idx, el_var(getRtlsym(RTLSYM.GCCARDN))),
        el_bin(OPeq, TYuchar,
               el_una(OPind, TYuchar, el_bin(OPadd, TYnptr, el_var(getRtlsym(RTLSYM.GCCARDBASE)), idx2)),
               el_long(TYuchar, 1)));

    // the second card: only when the span crosses into it
    elem* end = el_bin(OPshr, TYullong,
                       el_bin(OPadd, TYullong, rel2, el_long(TYullong, span)), el_long(TYint, 9));
    elem* end2 = el_same(end);
    elem* end3 = el_copytree(end2);
    elem* second = el_bin(OPandand, TYint,
        el_bin(OPne, TYint, end, idx3),
        el_bin(OPandand, TYint,
            el_bin(OPlt, TYint, end2, el_var(getRtlsym(RTLSYM.GCCARDN))),
            el_bin(OPeq, TYuchar,
                   el_una(OPind, TYuchar, el_bin(OPadd, TYnptr, el_var(getRtlsym(RTLSYM.GCCARDBASE)), end3)),
                   el_long(TYuchar, 1))));

    return el_combine(first, second);
}

/**
 * The barrier for one pointer store, expanded in place:
 * ---
 * idx = (cast(size_t) addr - __sd_gc_card_lo) >> 9;
 * if (idx < __sd_gc_card_n) __sd_gc_card_base[idx] = 1;
 * ---
 * the same test `_d_gcBarrier` makes, without the call. The store of the card
 * is a plain byte store, which is as strong as the call's release store on
 * x86, the only target this backend generates code for.
 * Params:
 *      addr = the address that was stored to (consumed)
 * Returns:
 *      the expression, of type int
 */
@trusted
elem* inlineBarrier(elem* addr)
{
    addr.Ety = TYullong;        // an address as a number (the same size)
    elem* rel = el_bin(OPmin, TYullong, addr, el_var(getRtlsym(RTLSYM.GCCARDLO)));
    elem* idx = el_bin(OPshr, TYullong, rel, el_long(TYint, 9));
    elem* idx2 = el_same(idx);          // idx = (tmp = ...); idx2 = tmp

    elem* inWindow = el_bin(OPlt, TYint, idx, el_var(getRtlsym(RTLSYM.GCCARDN)));

    elem* card = el_una(OPind, TYuchar,
                        el_bin(OPadd, TYnptr, el_var(getRtlsym(RTLSYM.GCCARDBASE)), idx2));
    elem* mark = el_bin(OPeq, TYuchar, card, el_long(TYuchar, 1));

    return el_bin(OPandand, TYint, inWindow, mark);
}

/**
 * `e` is an OPeq, OPstreq or OPmemcpy: add the call that follows it.
 * Params:
 *      e = the store
 *      used = is the value of the store used?
 * Returns:
 *      the store, or the store followed by the barrier
 */
@trusted
elem* store(elem* e, bool used)
{
    if (e.Eflags & (EFLAGS_ptrfree | EFLAGS_gcdone))
        return e;

    const op = e.Eoper;
    elem** paddr;           // where the address of the destination is
    elem* nbytes = null;    // the size, for a copy
    bool range = false;
    long inlineSpan = -1;   // >= 0: the range is small and constant, expanded in place

    if (op == OPmemcpy)
    {
        // memcpy(dst, src, n): E1 is dst, E2 is the list (src, n)
        if (e.E2.Eoper != OPparam)
            return e;

        paddr = &e.E1;
        if (isVariableAddress(*paddr))
            return e;

        range = true;
        nbytes = el_same(e.E2.E2);
    }
    else
    {
        // *p = value: a store through a pointer. A variable of the function
        // or a global is a root.
        elem* lhs = e.E1;
        if (lhs.Eoper != OPind || isVariableAddress(lhs.E1))
            return e;

        // Storing null cannot hide an object from the collector.
        if (op == OPeq && e.E2.Eoper == OPconst && typtr(tybasic(e.Ety)) && el_tolong(e.E2) == 0)
            return e;

        paddr = &lhs.E1;
        const ty = tybasic(e.Ety);
        size_t size;

        if (op == OPstreq)
        {
            if (!e.ET)
                return e;

            size = cast(size_t) type_size(e.ET);
            range = true;
        }
        else if (typtr(ty))
        {
            size = REGSIZE;
        }
        else if (ty == TYdarray || ty == TYdelegate)
        {
            size = tysize(ty);
            range = true;
        }
        else
            return e;       // not something that holds a pointer

        if (range)
        {
            nbytes = el_long(TYsize_t, size);
            // A copy of a known, small size is two card tests in place, not a call.
            if (size > 0 && size <= maxInlineRange)
                inlineSpan = cast(long) size - 1;
        }
    }

    // The address is used twice, by the store and by the barrier.
    elem* addr = el_same(*paddr);
    elem* again = used ? el_copytree(addr) : null;

    elem* call;
    if (range && inlineSpan >= 0)
    {
        el_free(nbytes);
        call = inlineBarrierSpan(addr, inlineSpan);
    }
    else if (range)
    {
        call = el_bin(OPcall, TYvoid, el_var(getRtlsym(RTLSYM.GCBARRIERRANGE)),
                      el_params(nbytes, addr, null));
    }
    else
    {
        call = inlineBarrier(addr);
    }

    elem* r = el_combine(e, call);
    if (!used)
        return r;

    // The value of the store is wanted: read it back. For a copy that is the
    // destination pointer; for a store, what was stored.
    elem* value;
    if (op == OPmemcpy)
    {
        value = again;
    }
    else
    {
        value = el_una(OPind, e.Ety, again);
        value.ET = e.ET;
    }

    return el_combine(r, value);
}
