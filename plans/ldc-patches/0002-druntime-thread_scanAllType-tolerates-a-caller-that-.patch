From 9a900c75103552ccb9845a263c6bc025d1e05142 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Thu, 8 Oct 2026 22:54:14 -0300
Subject: [PATCH 2/3] druntime: thread_scanAllType tolerates a caller that is
 not a druntime thread

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fMmy9fJzqrWoKLQjC8Ssf
---
 runtime/druntime/src/core/thread/threadbase.d | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/runtime/druntime/src/core/thread/threadbase.d b/runtime/druntime/src/core/thread/threadbase.d
index 64e7f3ad5b..8978cc6cd8 100644
--- a/runtime/druntime/src/core/thread/threadbase.d
+++ b/runtime/druntime/src/core/thread/threadbase.d
@@ -1145,7 +1145,7 @@ private void scanAllTypeImpl(scope ScanAllThreadsTypeFn scan, void* curStackTop)
     if (ThreadBase.sm_tbeg)
     {
         thisThread  = ThreadBase.getThis();
-        if (!thisThread.m_lock)
+        if (thisThread !is null && !thisThread.m_lock)
         {
             oldStackTop = thisThread.m_curr.tstack;
             thisThread.m_curr.tstack = curStackTop;
@@ -1156,7 +1156,7 @@ private void scanAllTypeImpl(scope ScanAllThreadsTypeFn scan, void* curStackTop)
     {
         if (ThreadBase.sm_tbeg)
         {
-            if (!thisThread.m_lock)
+            if (thisThread !is null && !thisThread.m_lock)
             {
                 thisThread.m_curr.tstack = oldStackTop;
             }
-- 
2.51.0

