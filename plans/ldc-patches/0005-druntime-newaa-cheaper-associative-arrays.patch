+            import core.exception : onOutOfMemoryError;
+            version (D_TypeInfo)
+                auto p = cast(Entry!(K, V)*) GC.calloc(nChunk * (Entry!(K, V)).sizeof, 0, typeid(Entry!(K, V)));
+            else
