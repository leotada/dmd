From fb0e4f3133efe313b5f27061fd1368f7c3188801 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Sat, 10 Oct 2026 17:09:43 -0300
Subject: [PATCH] gc-card-marking: skip pointer-free copies and mark card table
 loads invariant

---
 gen/arrays.cpp               | 10 ++++----
 gen/passes/GCCardMarking.cpp | 48 +++++++++++++++++++++++++++++++++++-
 gen/tollvm.cpp               | 19 +++++++++++---
 gen/tollvm.h                 | 17 ++++++++++++-
 4 files changed, 84 insertions(+), 10 deletions(-)

diff --git a/gen/arrays.cpp b/gen/arrays.cpp
index 4a4f007f89..f200d853da 100644
--- a/gen/arrays.cpp
+++ b/gen/arrays.cpp
@@ -144,7 +144,7 @@ static LLValue *computeSize(LLValue *length, size_t elementSize) {
 
 static void copySlice(Loc loc, LLValue *dstarr, LLValue *dstlen,
                       LLValue *srcarr, LLValue *srclen, size_t elementSize,
-                      bool knownInBounds) {
+                      bool knownInBounds, bool isPointerFree = false) {
   const bool checksEnabled =
       global.params.useAssert == CHECKENABLEon || gIR->emitArrayBoundsChecks();
   if (checksEnabled && !knownInBounds) {
@@ -157,7 +157,7 @@ static void copySlice(Loc loc, LLValue *dstarr, LLValue *dstlen,
     // sz1 == 0 at runtime, this would probably still be legal (the C spec
     // is unclear here).
     LLValue *size = computeSize(dstlen, elementSize);
-    DtoMemCpy(dstarr, srcarr, size);
+    DtoMemCpy(dstarr, srcarr, size, 1, isPointerFree);
   }
 }
 
@@ -239,7 +239,7 @@ void DtoArrayAssign(Loc loc, DValue *lhs, DValue *rhs, EXP op,
           }
         }
         copySlice(loc, lhsPtr, lhsLength, rhsPtr, rhsLength, elementSize,
-                  knownInBounds);
+                  knownInBounds, !hasPointers(elemType));
       }
     } else if (isConstructing) {
       error(
@@ -581,9 +581,9 @@ void initializeArrayLiteral(IRState *p, ArrayLiteralExp *ale,
       auto gvar = new llvm::GlobalVariable(gIR->module, constarr->getType(),
                                            true, LLGlobalValue::InternalLinkage,
                                            constarr, ".arrayliteral");
-      gvar->setUnnamedAddr(llvm::GlobalValue::UnnamedAddr::Global);
+      bool ptrFree = !hasPointers(ale->type->toBasetype()->nextOf());
       DtoMemCpy(dstMem, gvar,
-                DtoConstSize_t(getTypeAllocSize(constarr->getType())));
+                DtoConstSize_t(getTypeAllocSize(constarr->getType())), 1, ptrFree);
     }
   } else {
     // Store the elements one by one.
diff --git a/gen/passes/GCCardMarking.cpp b/gen/passes/GCCardMarking.cpp
index 8c6d42534d..4e089a4c58 100644
--- a/gen/passes/GCCardMarking.cpp
+++ b/gen/passes/GCCardMarking.cpp
@@ -68,11 +68,54 @@ struct Marker {
     return T->isPtrOrPtrVectorTy();
   }
 
+  static bool typeContainsPointers(Type *T) {
+    if (T->isPtrOrPtrVectorTy()) {
+      return true;
+    }
+    if (auto *ST = dyn_cast<StructType>(T)) {
+      for (Type *Elem : ST->elements()) {
+        if (typeContainsPointers(Elem))
+          return true;
+      }
+      return false;
+    }
+    if (auto *AT = dyn_cast<ArrayType>(T)) {
+      return typeContainsPointers(AT->getElementType());
+    }
+    if (auto *VT = dyn_cast<VectorType>(T)) {
+      return typeContainsPointers(VT->getElementType());
+    }
+    return false;
+  }
+
+  static bool isPointerFreeObject(const Value *V) {
+    const Value *Obj = getUnderlyingObject(V);
+    if (auto *AI = dyn_cast<AllocaInst>(Obj)) {
+      return !typeContainsPointers(AI->getAllocatedType());
+    }
+    if (auto *GV = dyn_cast<GlobalVariable>(Obj)) {
+      return !typeContainsPointers(GV->getValueType());
+    }
+    return false;
+  }
+
+  static bool isPointerFreeCopy(const MemTransferInst *MT) {
+    if (MT->hasMetadata("d.pointer_free")) {
+      return true;
+    }
+    if (isPointerFreeObject(MT->getRawSource()) ||
+        isPointerFreeObject(MT->getRawDest())) {
+      return true;
+    }
+    return false;
+  }
+
   void markCard(IRBuilder<> &B, Value *Addr) {
     B.CreateCall(CompilerBarrier);
     auto *Int = B.CreatePtrToInt(Addr, IntPtrTy);
     auto *Idx = B.CreateLShr(Int, ConstantInt::get(IntPtrTy, CardShift));
     auto *Base = B.CreateLoad(PointerType::getUnqual(C), CardBase);
+    Base->setMetadata(LLVMContext::MD_invariant_load, MDNode::get(C, {}));
     auto *Slot = B.CreateGEP(Type::getInt8Ty(C), Base, Idx);
     B.CreateStore(ConstantInt::get(Type::getInt8Ty(C), 1), Slot);
     markSummary(B, Int);
@@ -83,6 +126,7 @@ struct Marker {
   void markSummary(IRBuilder<> &B, Value *AddrInt) {
     auto *SIdx = B.CreateLShr(AddrInt, ConstantInt::get(IntPtrTy, SummaryShift));
     auto *SBase = B.CreateLoad(PointerType::getUnqual(C), SummaryBase);
+    SBase->setMetadata(LLVMContext::MD_invariant_load, MDNode::get(C, {}));
     auto *SSlot = B.CreateGEP(Type::getInt8Ty(C), SBase, SIdx);
     B.CreateStore(ConstantInt::get(Type::getInt8Ty(C), 1), SSlot);
   }
@@ -112,6 +156,7 @@ struct Marker {
     auto *Int = B.CreatePtrToInt(Addr, IntPtrTy);
     auto *Idx = B.CreateLShr(Int, ConstantInt::get(IntPtrTy, CardShift));
     auto *Base = B.CreateLoad(PointerType::getUnqual(C), CardBase);
+    Base->setMetadata(LLVMContext::MD_invariant_load, MDNode::get(C, {}));
     auto *Slot = B.CreateGEP(Type::getInt8Ty(C), Base, Idx);
     B.CreateStore(ConstantInt::get(Type::getInt8Ty(C), 1), Slot);
     markSummary(B, Int);
@@ -151,7 +196,8 @@ bool GCCardMarking::run(Module &M) {
           Work.push_back(&I);
         }
       } else if (auto *MT = dyn_cast<MemTransferInst>(&I)) {
-        if (!Marker::isUntracked(MT->getRawDest())) {
+        if (!Marker::isUntracked(MT->getRawDest()) &&
+            !Marker::isPointerFreeCopy(MT)) {
           Work.push_back(&I);
         }
       }
diff --git a/gen/tollvm.cpp b/gen/tollvm.cpp
index db52c38928..15262b2edd 100644
--- a/gen/tollvm.cpp
+++ b/gen/tollvm.cpp
@@ -438,15 +438,28 @@ void DtoMemSetZero(LLType *type, LLValue *dst, unsigned align) {
 
 ////////////////////////////////////////////////////////////////////////////////
 
-void DtoMemCpy(LLValue *dst, LLValue *src, LLValue *nbytes, unsigned align) {
+llvm::CallInst *DtoMemCpy(LLValue *dst, LLValue *src, LLValue *nbytes, unsigned align,
+                          bool pointerFree) {
   auto A = llvm::MaybeAlign(align);
-  gIR->ir->CreateMemCpy(dst, A, src, A, nbytes, false /*isVolatile*/);
+  auto *CI = gIR->ir->CreateMemCpy(dst, A, src, A, nbytes, false /*isVolatile*/);
+  if (pointerFree && CI) {
+    CI->setMetadata("d.pointer_free", llvm::MDNode::get(gIR->context(), {}));
+  }
+  return CI;
+}
+
+llvm::CallInst *DtoMemCpy(Type *type, LLValue *dst, LLValue *src, bool withPadding,
+                          unsigned align) {
+  uint64_t n =
+      withPadding ? getTypeAllocSize(DtoType(type)) : getTypeStoreSize(DtoType(type));
+  bool ptrFree = !hasPointers(type);
+  return DtoMemCpy(dst, src, DtoConstSize_t(n), align, ptrFree);
 }
 
 void DtoMemCpy(LLType *type, LLValue *dst, LLValue *src, bool withPadding, unsigned align) {
   uint64_t n =
       withPadding ? getTypeAllocSize(type) : getTypeStoreSize(type);
-  DtoMemCpy(dst, src, DtoConstSize_t(n), align);
+  DtoMemCpy(dst, src, DtoConstSize_t(n), align, false);
 }
 
 ////////////////////////////////////////////////////////////////////////////////
diff --git a/gen/tollvm.h b/gen/tollvm.h
index 59c71435e6..2feae5b10d 100644
--- a/gen/tollvm.h
+++ b/gen/tollvm.h
@@ -207,12 +207,27 @@ void DtoMemSetZero(LLType *type, LLValue *dst, unsigned align = 1);
  * @param src Source memory.
  * @param nbytes Number of bytes to copy.
  * @param align The minimum alignment of the source and destination memory.
+ * @param pointerFree Whether the copied data is known to contain no pointers.
  */
-void DtoMemCpy(LLValue *dst, LLValue *src, LLValue *nbytes, unsigned align = 1);
+llvm::CallInst *DtoMemCpy(LLValue *dst, LLValue *src, LLValue *nbytes, unsigned align = 1,
+                          bool pointerFree = false);
+
+/**
+ * The same as DtoMemCpy but figures out the size and pointerFree status based on
+ * the D type.
+ * @param type D type being copied.
+ * @param dst Destination memory.
+ * @param src Source memory.
+ * @param withPadding Use the type's padded size, not its store size.
+ * @param align The minimum alignment of the source and destination memory.
+ */
+llvm::CallInst *DtoMemCpy(Type *type, LLValue *dst, LLValue *src, bool withPadding = false,
+                          unsigned align = 1);
 
 /**
  * The same as DtoMemCpy but figures out the size itself based on the dst
  * pointee.
+ * @param type LLVM type.
  * @param dst Destination memory.
  * @param src Source memory.
  * @param withPadding Use the dst pointee's padded size, not its store size.
-- 
2.51.0

