+	void combineSweptSlabs(ref PriorityExtentHeap[BinCount] collectedSlabs) {
+		auto sharedThis = cast(shared(PageFiller)*) &this;
 		sharedThis.arena.combineBinsAfterCollection(collectedSlabs);
 	}
 
