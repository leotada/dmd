+		if (!hasFinalizers) {
+			import core.atomic : atomicOp;
+			atomicOp!"|="(*cast(shared(size_t)*) &_sweepTag, HasFinalizersBit);
+		}
 	}
 
+	private enum HasFinalizersBit = size_t(1) << 8;
+
 	/**
