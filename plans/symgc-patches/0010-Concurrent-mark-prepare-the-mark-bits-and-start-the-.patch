+							freshSlab.sweepTag = epoch;
+						}
+
 						slabs.insert(freshSlab);
 						freshSlab = null;
 						continue;
@@ -221,6 +232,12 @@ package:
 		(cast(PriorityExtentHeap*) &slabs).clear();
