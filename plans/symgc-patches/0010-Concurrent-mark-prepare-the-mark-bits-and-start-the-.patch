+	// The concurrent prepare of the mark bits: where it is, like the sweep.
+	bool preparing;
+	uint prepareEpoch;
+	ushort prepareSerial;
+	BlockDescriptor* prepareNext;
+	BlockDescriptor* prepareCurrent;
+	uint preparePage;
+	ulong[] prepareBitmaps;
