From 083ba8171b2aec412312b295789a3bf9475141f3 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Thu, 8 Oct 2026 23:08:40 -0300
Subject: [PATCH 14/16] Card table is mapped in .preinit_array; sweepTag update
 is a compare and swap

The constructors of a program run in no defined order, and a pointer store
before the table exists crashed. The epoch half of _sweepTag is replaced with
a CAS because the flag bits above it are set without a lock.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fMmy9fJzqrWoKLQjC8Ssf
---
 source/d/gc/cards.d  | 17 +++++++++++++++--
 source/d/gc/extent.d | 18 +++++++++++++++++-
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/source/d/gc/cards.d b/source/d/gc/cards.d
index 5693d9d..37ec9db 100644
--- a/source/d/gc/cards.d
+++ b/source/d/gc/cards.d
@@ -34,9 +34,16 @@ enum TableSize = size_t(1) << (47 - CardShift);
  */
 extern(C) __gshared ubyte* __sd_gc_card_base;
 
-// Mapped before any code that stores a pointer runs, not lazily.
-pragma(crt_constructor)
+/**
+ * Mapped before any code that stores a pointer runs, not lazily. The
+ * constructors of the program run in no defined order, so this goes in
+ * `.preinit_array`, which the dynamic loader runs before all of them.
+ */
 extern(C) void __sd_gc_card_init() {
+	if (__sd_gc_card_base !is null) {
+		return;
+	}
+
 	enum MAP_NORESERVE = 0x4000; // Linux
 	enum Flags = MAP_PRIVATE | MAP_ANON | MAP_NORESERVE;
 	auto p = mmap(null, TableSize, PROT_READ | PROT_WRITE, Flags, -1, 0);
@@ -143,3 +150,9 @@ size_t collectCards(size_t start, size_t size, scope void delegate(const(void)*,
 void clearCards(size_t start, size_t size) {
 	collectCards(start, size, null);
 }
+
+version(LDC) {
+	import ldc.attributes : section;
+
+	@section(".preinit_array") __gshared extern(C) void function() __sd_gc_card_preinit = &__sd_gc_card_init;
+}
diff --git a/source/d/gc/extent.d b/source/d/gc/extent.d
index f10d3f2..1db51fd 100644
--- a/source/d/gc/extent.d
+++ b/source/d/gc/extent.d
@@ -282,7 +282,23 @@ public:
 	 */
 	@property
 	void sweepTag(uint tag) {
-		_sweepTag = (_sweepTag & ~size_t(uint.max)) | tag;
+		/**
+		 * The flag bits above the epoch are set by the threads that
+		 * allocate from the slab, without a lock (`setHasFinalizers`), so
+		 * the epoch is replaced with a compare and swap: a plain
+		 * read-modify-write loses a flag set in between, and with it the
+		 * finalizers of that slab (run too late, after their partners'
+		 * slots were reused).
+		 */
+		import core.atomic : atomicLoad, cas;
+		auto p = cast(shared(size_t)*) &_sweepTag;
+		while (true) {
+			auto old = atomicLoad(*p);
+			auto n = (old & ~size_t(uint.max)) | tag;
+			if (cas(p, old, n)) {
+				break;
+			}
+		}
 	}
 
 	/**
