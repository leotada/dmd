From b5fa1f3b92c71671168a60b05eaa41e720acae92 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Thu, 8 Oct 2026 23:30:10 -0300
Subject: [PATCH 16/19] Run the finalizers of every arena before any arena
 releases a slot

The sweep of one arena finalized its own dead objects and then released them,
independently of the others. An object whose destructor reads one in another
arena found it freed and reused (class A with a destructor and a pointer to a
B, in two arenas): the order depended on which arena the collector visited
first, which is why DMD builds passed and LDC builds failed. The sweep is now
three stages (begin, finalize, finish) driven across the arenas by the
collector, a global flag keeps the assists out until the finalizers are done,
and a step that ends the finalize phase no longer rolls on into the scan.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fMmy9fJzqrWoKLQjC8Ssf
---
 source/d/gc/arena.d     | 12 ++++++++++
 source/d/gc/collector.d | 28 +++++++++++++++++++++-
 source/d/gc/extent.d    |  7 ++++++
 source/d/gc/page.d      | 51 ++++++++++++++++++++++++++++++++++++++---
 4 files changed, 94 insertions(+), 4 deletions(-)

diff --git a/source/d/gc/arena.d b/source/d/gc/arena.d
index 2c70f1c..5fdaf5e 100644
--- a/source/d/gc/arena.d
+++ b/source/d/gc/arena.d
@@ -255,6 +255,18 @@ package:
 		return filler.collect(emap, gcCycle, stats);
 	}
 
+	void beginSweep(ubyte gcCycle) shared {
+		filler.beginSweep(gcCycle);
+	}
+
+	void sweepFinalizers(ref CachedExtentMap emap, ubyte gcCycle) shared {
+		filler.sweepFinalizers(emap, gcCycle);
+	}
+
+	void finishSweep(ref CachedExtentMap emap, ubyte gcCycle, ref CollectStats stats) shared {
+		filler.finishSweep(emap, gcCycle, stats);
+	}
+
 	AssistResult assistSweep(ref CachedExtentMap emap) shared {
 		return filler.assistSweep(emap);
 	}
diff --git a/source/d/gc/collector.d b/source/d/gc/collector.d
index ccb2f0f..34be3e2 100644
--- a/source/d/gc/collector.d
+++ b/source/d/gc/collector.d
@@ -761,12 +761,38 @@ private:
 		threadCache.startCollection();
 		scope(exit) threadCache.endCollection();
 
+		/**
+		 * Every finalizer of the cycle runs before any dead slot is
+		 * released, in any arena: a destructor may read an object that is
+		 * dead too, and it can be in another arena than the one it is in.
+		 */
+		import d.gc.extent : gFinalizeStage;
+		gFinalizeStage.store(1);
+
+		foreach (i; 0 .. ArenaCount) {
+			import d.gc.arena;
+			auto a = Arena.getIfInitialized(i);
+			if (a !is null) {
+				a.beginSweep(gcCycle);
+			}
+		}
+
+		foreach (i; 0 .. ArenaCount) {
+			import d.gc.arena;
+			auto a = Arena.getIfInitialized(i);
+			if (a !is null) {
+				a.sweepFinalizers(emap, gcCycle);
+			}
+		}
+
+		gFinalizeStage.store(0);
+
 		CollectStats stats;
 		foreach (i; 0 .. ArenaCount) {
 			import d.gc.arena;
 			auto a = Arena.getIfInitialized(i);
 			if (a !is null) {
-				a.collect(emap, gcCycle, stats);
+				a.finishSweep(emap, gcCycle, stats);
 			}
 		}
 		return stats;
diff --git a/source/d/gc/extent.d b/source/d/gc/extent.d
index 1db51fd..d80c4a2 100644
--- a/source/d/gc/extent.d
+++ b/source/d/gc/extent.d
@@ -115,6 +115,13 @@ shared Atomic!ubyte gMarkActive;
  */
 shared Atomic!ubyte gAnyFinalizers;
 
+/**
+ * Set while the finalizers of a cycle run, in every arena. A dead slot is
+ * not released anywhere until they all ran: an object in one arena can point
+ * to one in another, and its destructor may read it.
+ */
+shared Atomic!ubyte gFinalizeStage;
+
 struct Extent {
 private:
 	/**
diff --git a/source/d/gc/page.d b/source/d/gc/page.d
index a0dfef7..73bcd20 100644
--- a/source/d/gc/page.d
+++ b/source/d/gc/page.d
@@ -436,14 +436,45 @@ public:
 	 * is released between blocks.
 	 */
 	void collect(ref CachedExtentMap emap, ubyte gcCycle, ref CollectStats stats) shared {
+		beginSweep(gcCycle);
+		sweepFinalizers(emap, gcCycle);
+		finishSweep(emap, gcCycle, stats);
+	}
+
+	/**
+	 * The sweep of a cycle in three stages, so that the collector can run the
+	 * finalizers of all the arenas before any arena releases a slot.
+	 */
+	void beginSweep(ubyte gcCycle) shared {
 		auto self = cast(PageFiller*) &this;
 
-		{
+		mutex.lock();
+		scope(exit) mutex.unlock();
+
+		self.beginSweepImpl(gcCycle);
+	}
+
+	/**
+	 * Run the finalizer phases, and stop when the sweep moves on to the next.
+	 */
+	void sweepFinalizers(ref CachedExtentMap emap, ubyte gcCycle) shared {
+		auto self = cast(PageFiller*) &this;
+
+		while (true) {
 			mutex.lock();
-			scope(exit) mutex.unlock();
+			scope(exit) mutex.unlockFairly();
+
+			if (self.sweepPhase != SweepPhase.DenseFinalize
+				    && self.sweepPhase != SweepPhase.SparseFinalize) {
+				return;
+			}
 
-			self.beginSweepImpl(gcCycle);
+			self.sweepStep(emap, gcCycle, self.sweepStats);
 		}
+	}
+
+	void finishSweep(ref CachedExtentMap emap, ubyte gcCycle, ref CollectStats stats) shared {
+		auto self = cast(PageFiller*) &this;
 
 		// Mutators may do some of the work too, see `assistSweep`, so the
 		// stats of the sweep live in the filler.
@@ -1202,6 +1233,12 @@ private:
 			return AssistResult.Waiting;
 		}
 
+		// Another arena may still be running its finalizers.
+		import d.gc.extent : gFinalizeStage;
+		if (gFinalizeStage.load() != 0) {
+			return AssistResult.Waiting;
+		}
+
 		mutex.lock();
 		scope(exit) mutex.unlockFairly();
 
@@ -1411,6 +1448,14 @@ private:
 					if (sweepCurrent is null) {
 						sweepPhase = DenseScan;
 						sweepNext = denseBlocks.first;
+
+						// The other arenas may still be finalizing: nothing
+						// is released before all of them are done.
+						import d.gc.extent : gFinalizeStage;
+						if (gFinalizeStage.load() != 0) {
+							return true;
+						}
+
 						continue;
 					}
 
