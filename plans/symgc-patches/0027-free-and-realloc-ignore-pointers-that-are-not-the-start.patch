From f31db93dea625aefb491862ba5458f7e25033dc6 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Fri, 9 Oct 2026 17:50:27 -0300
Subject: [PATCH 3/5] free and realloc ignore pointers that are not the start
 of a GC block

GC.free(&local) or GC.realloc(interior) asserted in getPageDescriptor (debug)
or went on with a bad descriptor (release); the other collectors ignore the
first and return null for the second. A throw with a lock held also left the
lock held: the druntime core.memory unit test hung on it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fMmy9fJzqrWoKLQjC8Ssf
---
 source/d/gc/tcache.d | 32 ++++++++++++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/source/d/gc/tcache.d b/source/d/gc/tcache.d
index 5ac78c1..9fdd82e 100644
--- a/source/d/gc/tcache.d
+++ b/source/d/gc/tcache.d
@@ -339,10 +339,32 @@ public:
 			return;
 		}
 
-		auto pd = getPageDescriptor(ptr);
+		// Like the other collectors, ignore what we did not hand out: a
+		// pointer to the stack, to malloc'd memory, or into the middle of a
+		// block.
+		auto pd = maybeGetPageDescriptor(ptr);
+		if (!isBlockStart(pd, ptr)) {
+			return;
+		}
+
 		free(pd, ptr);
 	}
 
+	/**
+	 * Whether `ptr` is the first byte of an allocation of ours.
+	 */
+	bool isBlockStart(PageDescriptor pd, const void* ptr) {
+		if (pd.extent is null) {
+			return false;
+		}
+
+		if (pd.isSlab()) {
+			return SlabAllocInfo(pd, ptr).address is ptr;
+		}
+
+		return ptr is pd.extent.address;
+	}
+
 	void free(PageDescriptor pd, void* ptr) {
 		shadeReleasedBlock(pd, ptr);
 
@@ -420,8 +442,14 @@ public:
 			return alloc(size, containsPointers, false);
 		}
 
+		// Not ours, or not the start of a block: the other collectors
+		// refuse these, and so do we.
+		auto pd = maybeGetPageDescriptor(ptr);
+		if (!isBlockStart(pd, ptr)) {
+			return null;
+		}
+
 		auto copySize = size;
-		auto pd = getPageDescriptor(ptr);
 
 		auto ec = pd.extentClass;
 		auto samePointerness = containsPointers == pd.containsPointers;
