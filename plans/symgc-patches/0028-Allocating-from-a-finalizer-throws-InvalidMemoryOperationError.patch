From a9d4d53cb58f6f798c69040c439535ee50d24e50 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Fri, 9 Oct 2026 17:50:27 -0300
Subject: [PATCH 4/5] Allocating from a finalizer throws
 InvalidMemoryOperationError

A finalizer runs with the page filler's lock held, so an allocation from it
waited for itself forever (druntime core.memory unit test, a class whose
destructor calls GC.malloc). Check inFinalizer in malloc/calloc/qalloc/realloc
like the other collectors do.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fMmy9fJzqrWoKLQjC8Ssf
---
 source/symgc/gcobj.d | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/source/symgc/gcobj.d b/source/symgc/gcobj.d
index a8525a1..adf0c2c 100644
--- a/source/symgc/gcobj.d
+++ b/source/symgc/gcobj.d
@@ -225,6 +225,7 @@ final class SnazzyGC : GC
 	 */
 	void* realloc(void* p, size_t size, uint bits, const TypeInfo ti) nothrow
 	{
+		checkNotInFinalizer();
 		return __sd_gc_hook_realloc(p, size, (bits & BlkAttr.NO_SCAN) == 0);
 	}
 
@@ -466,8 +467,24 @@ void* getContextPointer(uint bits, const TypeInfo ti) nothrow @nogc
 	return null;
 }
 
+/**
+ * A finalizer runs while the collector holds the page filler's lock, so an
+ * allocation from it would wait for itself forever. It is an error in D too:
+ * the other collectors throw InvalidMemoryOperationError.
+ */
+void checkNotInFinalizer() nothrow
+{
+	import d.gc.tcache;
+	if (threadCache.inFinalizer) {
+		import core.exception : onInvalidMemoryOperationError;
+		onInvalidMemoryOperationError();
+	}
+}
+
 void *sdcAllocate(size_t size, uint bits, bool zeroData, const TypeInfo ti) nothrow
 {
+	checkNotInFinalizer();
+
 	if (size == 0)
 		return null;
 
