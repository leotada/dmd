From 08e55cc92efdabcb3aa81b54b8cee62b475b7da2 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Sat, 10 Oct 2026 21:03:33 -0300
Subject: [PATCH] collector: respect SYMGC_MARK_THREADS in STW mark, default
 SYMGC_MARK_NICE to 10

---
 source/d/gc/collector.d | 12 +++++++++---
 source/d/gc/scanner.d   |  4 +++-
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/source/d/gc/collector.d b/source/d/gc/collector.d
index 6a92e81..3256ece 100644
--- a/source/d/gc/collector.d
+++ b/source/d/gc/collector.d
@@ -269,9 +269,15 @@ private:
 		// start the threads
 		auto threadCount = gCollectorState.scanningThreads;
 		if (threadCount == 0) {
-			import d.gc.cpu;
-			threadCount = getCoreCount();
-			assert(threadCount >= 1, "Expected at least one thread!");
+			import core.stdc.stdlib : getenv, atoi;
+			auto env = getenv("SYMGC_MARK_THREADS");
+			if (env !is null && atoi(env) > 0) {
+				threadCount = atoi(env);
+			} else {
+				import d.gc.cpu;
+				threadCount = getCoreCount();
+				assert(threadCount >= 1, "Expected at least one thread!");
+			}
 		}
 
 		import symgc.thread;
diff --git a/source/d/gc/scanner.d b/source/d/gc/scanner.d
index 17851ca..9996c6f 100644
--- a/source/d/gc/scanner.d
+++ b/source/d/gc/scanner.d
@@ -417,9 +417,11 @@ public:
 			version(linux) {
 				import core.stdc.stdlib : getenv, atoi;
 				import core.sys.posix.sys.resource : setpriority, PRIO_PROCESS;
+				int nice = 10;
 				if (auto env = getenv("SYMGC_MARK_NICE")) {
-					setpriority(PRIO_PROCESS, 0, atoi(env));
+					nice = atoi(env);
 				}
+				setpriority(PRIO_PROCESS, 0, nice);
 			}
 
 			// Set a flag saying we should not be using our local thread cache.
-- 
2.51.0

