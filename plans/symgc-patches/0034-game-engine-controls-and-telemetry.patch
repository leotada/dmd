index b99d514..1dd2a22 100644
--- a/source/d/gc/tstate.d
+++ b/source/d/gc/tstate.d
@@ -82,9 +82,13 @@ public:
 		}
 	}
 
-	void preventPausing() {
+	void preventPausing() nothrow @nogc {
 		auto s = state.load();
 		while (true) {
+			if (status(s) == SuspendState.Detached) {
+				break;
+			}
+
 			auto n = s + SuspendState.Detached;
 
 			assert(status(s) == SuspendState.None);
@@ -96,6 +100,23 @@ public:
 		}
 	}
 
+	void allowPausing() nothrow @nogc {
+		auto s = state.load();
+		while (true) {
+			if (status(s) == SuspendState.None) {
+				break;
+			}
+
+			assert(status(s) == SuspendState.Detached);
+			auto n = s - SuspendState.Detached;
+			assert(status(n) == SuspendState.None);
+
+			if (state.casWeak(s, n)) {
+				break;
+			}
+		}
+	}
+
 	bool onSuspendSignal() {
 		auto s = state.load();
 
diff --git a/source/symgc/gcobj.d b/source/symgc/gcobj.d
