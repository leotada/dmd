@@ -153,13 +160,37 @@ void scanWorldPausedData(ScanDg scan) {
 	// thread that is not a druntime thread has none.
 	auto self = Thread.getThis();
 	auto myStackBottom = self is null ? null : self.m_curr.bstack;
+
+	void*[2][8] detachedStacks = void;
+	size_t numDetached = 0;
+	foreach(t; ThreadIterator(ThreadBase.sm_tbeg.toThread)) {
+		import d.gc.tcache : ThreadCache;
+		import d.gc.tstate : SuspendState;
+		auto tc = cast(ThreadCache*) t.tlsGCData();
+		if (tc !is null && tc.suspendState == SuspendState.Detached && numDetached < 8) {
+			auto b = t.m_curr.bstack;
+			auto top = t.m_curr.tstack;
+			if (b !is null) {
+				detachedStacks[numDetached][0] = top < b ? top : b;
+				detachedStacks[numDetached][1] = top < b ? b : top;
+				numDetached++;
+			}
+		}
+	}
+
 	void scanItem(ScanType type, void* pbot, void* ptop) nothrow {
 		import d.gc.range;
 		auto r = makeRange(pbot, ptop);
-		if (type == ScanType.stack && myStackBottom !is null && myStackBottom >= r.ptr &&
-				myStackBottom <= r.ptr + r.length)
-			// my stack range, no need to scan right now, this will be scanned later
-			return;
+		if (type == ScanType.stack) {
+			if (myStackBottom !is null && myStackBottom >= r.ptr &&
+					myStackBottom <= r.ptr + r.length)
+				// my stack range, no need to scan right now, this will be scanned later
+				return;
+			foreach(i; 0 .. numDetached) {
+				if (r.ptr >= detachedStacks[i][0] && r.ptr <= detachedStacks[i][1])
+					return; // Skip stack of detached/RT audio thread
+			}
+		}
 		// TODO: ignore my thread's TLS data as well.
 		// TODO: shouldn't need this cast
 		alias NoThrowScanDg = void delegate(const(void*)[] range) nothrow;
@@ -186,6 +217,8 @@ bool resumeDruntimeThreads(ref uint suspended) {
 		}
 
 		auto ss = tc.suspendState;
+		if (ss == SuspendState.Detached)
+			continue;
 
 		version(Posix) {
 			suspended += ss == SuspendState.Suspended;
diff --git a/source/d/gc/capi.d b/source/d/gc/capi.d
index 27e1094..fc8fe2d 100644
--- a/source/d/gc/capi.d
+++ b/source/d/gc/capi.d
@@ -134,3 +134,24 @@ void __sd_gc_time_total(ulong* dst) {
 PageDescriptor __sd_gc_maybe_get_page_descriptor(void* ptr) {
 	return threadCache.maybeGetPageDescriptor(ptr);
 }
+
+void __sd_gc_exclude_current_thread() {
+	threadCache.state.preventPausing();
+	threadCache.activateGC(false);
+}
+
+void __sd_gc_include_current_thread() {
+	threadCache.state.allowPausing();
+	threadCache.activateGC(true);
+}
+
+bool __sd_gc_is_thread_excluded() {
+	import d.gc.tstate : SuspendState;
+	return threadCache.state.suspendState == SuspendState.Detached;
+}
+
+void __sd_gc_step(ulong maxTimeHns) {
+	import d.gc.collector;
+	auto collector = Collector(&threadCache);
+	collector.assistSweepTimed(maxTimeHns);
+}
diff --git a/source/d/gc/collector.d b/source/d/gc/collector.d
index 3256ece..861b935 100644
--- a/source/d/gc/collector.d
+++ b/source/d/gc/collector.d
@@ -169,6 +169,49 @@ struct Collector {
 		}
 	}
 
+	/**
+	 * Helps background sweeping up to maxTimeHns (100ns units).
+	 * If maxTimeHns is 0, performs a single pass across arenas.
+	 */
+	void assistSweepTimed(ulong maxTimeHns) {
+		import d.gc.extent : gSweepCycle;
+		import d.gc.page : AssistResult;
+		import d.gc.time : getMonotonicTime;
+
+		if (gSweepCycle.load() == 0) {
+			return;
+		}
+
+		auto start = getMonotonicTime();
+
+		threadCache.startCollection();
+		scope(exit) threadCache.endCollection();
+
+		while (gSweepCycle.load() != 0) {
+			bool worked = false;
+			bool waiting = false;
+			foreach (i; 0 .. ArenaCount) {
+				auto a = Arena.getIfInitialized(i);
+				if (a !is null) {
+					auto r = a.assistSweep(emap);
+					worked |= r == AssistResult.Worked;
+					waiting |= r == AssistResult.Waiting;
+				}
+			}
+
+			if (!worked && !waiting) {
+				break;
+			}
+
+			if (maxTimeHns > 0 && (getMonotonicTime() - start) >= maxTimeHns) {
+				break;
+			}
+			if (maxTimeHns == 0) {
+				break;
+			}
+		}
+	}
+
 	void runGCCycle() {
 		/**
 		 * An explicit collection is synchronous: let a running background
