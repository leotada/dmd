From ee47f7a056f50177b7f327dce528d167c29934a4 Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Tue, 13 Oct 2026 11:16:18 -0300
Subject: [PATCH] gcobj: attach druntime threads through the module's
 thread-local constructor when druntime has no thread hook

druntime before 2.112 (GDC 15 ships 2.111) does not accept a thread-init function in
registerGCFactory, so it never told the collector about its threads, and the first
stop-the-world asserted 'tlsGCData was not set for this thread!' (SIGILL in a release
build). static this/~this of symgc.gcobj run on every druntime thread, before its function
and before it leaves druntime's list: the moments the hook has. The thread that ran
initialize is registered already and only gets its tlsGCData set.

GDC 15.3 (system), kernel tracker: mark_race, mark_race_glue, finalizer_order and
thread_exit_race pass (they crashed before). Project DMD with the hook: unchanged
(mark_race, thread_exit_race, finalizer_order pass).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 source/symgc/gcobj.d | 48 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/source/symgc/gcobj.d b/source/symgc/gcobj.d
index 40767b8..7f60a0b 100644
--- a/source/symgc/gcobj.d
+++ b/source/symgc/gcobj.d
@@ -82,6 +82,52 @@ private pragma(crt_constructor) void gc_sdc_ctor()
 	_d_register_sdc_gc();
 }
 
+// A druntime older than 2.112 (GDC 15 ships 2.111) has no thread-init hook in
+// registerGCFactory: it never tells the collector about the threads it creates, so
+// the first stop-the-world finds a druntime thread without a thread cache.
+// Such a druntime runs every module's thread-local constructor when a thread
+// starts, before its function, and the destructor when the function returns,
+// before the thread leaves druntime's list: the same two moments the hook has.
+enum druntimeCallsThreadHooks = __traits(compiles, {
+	import core.gc.registry;
+	registerGCFactory("sdc", &initialize, &initSDCThread);
+});
+
+static if (!druntimeCallsThreadHooks) version (Posix)
+{
+	// Set on the thread that created the process state (the one that ran initialize):
+	// it is registered already, and lives as long as the collector.
+	private bool processThread;
+
+	static this()
+	{
+		import core.thread : Thread;
+		import d.gc.tcache;
+
+		auto t = Thread.getThis();
+		if (t is null || t.tlsGCData !is null)
+			return;
+
+		if (processThread)
+			t.tlsGCData = &threadCache;
+		else
+			initSDCThread(t);
+	}
+
+	static ~this()
+	{
+		import core.thread : Thread;
+		import d.gc.tcache;
+
+		auto t = Thread.getThis();
+		if (t is null || processThread || t.tlsGCData !is &threadCache)
+			return;
+
+		import d.gc.thread;
+		(cast(void function() nothrow @nogc)&destroyThread)();
+	}
+}
+
 extern(C) void thread_setGCSignals(int suspendSignalNo, int resumeSignalNo) nothrow @nogc;
 
 extern(C) void _d_register_sdc_gc()
@@ -129,6 +175,8 @@ private GC initializeQuiet()
 		// now it is ok to initialize
 		import d.gc.thread;
 		createProcess();
+		static if (!druntimeCallsThreadHooks) version (Posix)
+			processThread = true;
 	}
 
 	// check the config to see if we should set the thread count for scanning.
-- 
2.51.0

