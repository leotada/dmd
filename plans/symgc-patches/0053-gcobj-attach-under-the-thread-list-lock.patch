From c5f291b10974b86117506449834424beacd7a77a Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Tue, 13 Oct 2026 12:29:53 -0300
Subject: [PATCH] gcobj: attach a druntime thread under the thread-list lock;
 the stop leaves not-yet-attached threads running

The first version (0052) raced: a thread is on druntime's list from before it runs its
thread-local constructors, so a stop-the-world in that window found a thread with no thread
cache (SIGILL on the assert in suspendDruntimeThreads, thread_exit_race, 4 of 6 runs on plain
GDC 15.3 after a long run). Stopping such a thread with druntime alone deadlocked (it may be
inside createThread holding a collector lock).

Now the constructor registers the thread between thread_preStopTheWorld and
thread_postRestartTheWorld, i.e. under the list's lock, which the stop takes before its own
lock: the thread is wholly before the stop or wholly after it. suspendDruntimeThreads skips a
thread without a cache when druntime has no hooks (the assert stays for the others).

thread_exit_race on GDC 15.3, 16 of 16 runs pass (plain and with the barrier plugin), 62-69k
threads each; the project DMD, which has the hook, is unchanged.
Limit: a thread-local constructor of another module that allocates before symgc.gcobj's runs
unregistered; with a hook-less druntime keep such constructors free of GC allocation.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 source/core/thread/symthread.d | 10 +++++++++-
 source/symgc/gcobj.d           | 18 ++++++++++++++++--
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/source/core/thread/symthread.d b/source/core/thread/symthread.d
index d3737de..2fc7465 100644
--- a/source/core/thread/symthread.d
+++ b/source/core/thread/symthread.d
@@ -5,6 +5,7 @@ import core.thread.osthread;
 import core.thread.threadbase;
 import core.thread.types;
 import d.gc.types;
+import symgc.gcobj : druntimeCallsThreadHooks;
 
 private {
 	import core.internal.traits : externDFunc;
@@ -77,7 +78,14 @@ bool suspendDruntimeThreads(bool alwaysSignal, ref uint suspended) {
 		auto tc = cast(ThreadCache*) t.tlsGCData();
 
 		if (tc is null) {
-			assert(0, "tlsGCData was not set for this thread!");
+			// A druntime without thread hooks (see symgc.gcobj): a thread that is on the list
+			// but has not run its thread-local constructors yet. It attaches under the list's
+			// lock, which the stop holds, so it cannot be half registered, and it has not
+			// touched the collector. It is left running. With the hooks this cannot happen.
+			static if (druntimeCallsThreadHooks)
+				assert(0, "tlsGCData was not set for this thread!");
+			else
+				continue;
 		}
 		version (Posix)
 		{
diff --git a/source/symgc/gcobj.d b/source/symgc/gcobj.d
index 7f60a0b..955de48 100644
--- a/source/symgc/gcobj.d
+++ b/source/symgc/gcobj.d
@@ -95,6 +95,11 @@ enum druntimeCallsThreadHooks = __traits(compiles, {
 
 static if (!druntimeCallsThreadHooks) version (Posix)
 {
+	// The lock of druntime's thread list is taken and released through these two (their names say
+	// what the collector uses them for).
+	extern(C) private void thread_preStopTheWorld() nothrow @nogc;
+	extern(C) private void thread_postRestartTheWorld() nothrow @nogc;
+
 	// Set on the thread that created the process state (the one that ran initialize):
 	// it is registered already, and lives as long as the collector.
 	private bool processThread;
@@ -109,9 +114,18 @@ static if (!druntimeCallsThreadHooks) version (Posix)
 			return;
 
 		if (processThread)
+		{
 			t.tlsGCData = &threadCache;
-		else
-			initSDCThread(t);
+			return;
+		}
+
+		// The stop-the-world holds the list's lock (thread_preStopTheWorld) before it takes
+		// its own, so registering under that lock puts this thread either wholly before the
+		// stop (it is signalled like any other) or wholly after it (it never saw the world
+		// stopped half way through registering).
+		thread_preStopTheWorld();
+		scope(exit) thread_postRestartTheWorld();
+		initSDCThread(t);
 	}
 
 	static ~this()
-- 
2.51.0

