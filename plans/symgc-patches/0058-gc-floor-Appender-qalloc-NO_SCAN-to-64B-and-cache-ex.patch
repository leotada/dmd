From 8f429d7d643009f2a6175d76cf9d684688d4461d Mon Sep 17 00:00:00 2001
From: Leonardo Tada Antunes <leonardotada@gmail.com>
Date: Tue, 13 Oct 2026 17:43:41 -0300
Subject: [PATCH] gc: floor Appender qalloc NO_SCAN to 64B and cache extend
 lookup

Phobos Appender/format calls GC.qalloc with NO_SCAN only (never APPENDABLE),
so the 0056 allocAppendable size floor never ran. Floor small plain NO_SCAN
qalloc requests to 64 bytes so a typical format line is one slot; use the
thread pd cache for GC.extend soft lookups on slab pointers.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 source/d/gc/tcache.d | 19 +++++++++++++++++++
 source/symgc/gcobj.d | 16 ++++++++++++++--
 2 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/source/d/gc/tcache.d b/source/d/gc/tcache.d
index 894f510..a6bdae5 100644
--- a/source/d/gc/tcache.d
+++ b/source/d/gc/tcache.d
@@ -1328,6 +1328,25 @@ private:
 		return pd;
 	}
 
+	/**
+	 * Soft page-descriptor lookup with the same one-page cache. Used by
+	 * `GC.extend`, which must return 0 for unknown / slab pointers without
+	 * asserting.
+	 */
+	public auto maybeGetPageDescriptorCached(void* ptr) {
+		auto aptr = alignDown(ptr, PageSize);
+		if (likely(aptr is pdCachePage) && pdCachePD.extent !is null) {
+			return pdCachePD;
+		}
+
+		auto pd = maybeGetPageDescriptor(ptr);
+		if (pd.extent !is null) {
+			pdCachePage = aptr;
+			pdCachePD = pd;
+		}
+		return pd;
+	}
+
 	package auto maybeGetPageDescriptor(const void* ptr) {
 		auto aptr = alignDown(ptr, PageSize);
 		return emap.lookup(aptr);
diff --git a/source/symgc/gcobj.d b/source/symgc/gcobj.d
index 6521a89..5b052b1 100644
--- a/source/symgc/gcobj.d
+++ b/source/symgc/gcobj.d
@@ -236,6 +236,17 @@ final class SnazzyGC : SnazzyBases
 	 */
 	BlkInfo qalloc(size_t size, uint bits, const scope TypeInfo ti) nothrow
 	{
+		// Phobos Appender (std.format) calls qalloc with NO_SCAN only — never
+		// APPENDABLE — and starts at 8 bytes, then 8→16→32→64 with a failed
+		// GC.extend between each step. Floor plain small NO_SCAN requests so
+		// one slot covers a typical format line; bi.size reports the full slot.
+		enum qallocNoScanFloor = 64;
+		if (size > 0 && size < qallocNoScanFloor
+		    && (bits & BlkAttr.NO_SCAN) != 0
+		    && (bits & (BlkAttr.APPENDABLE | BlkAttr.FINALIZE)) == 0) {
+			size = qallocNoScanFloor;
+		}
+
 		auto ptr = sdcAllocate(size, bits, false, ti);
 
 		if (!ptr)
@@ -596,10 +607,11 @@ size_t extendLarge(void* p, size_t minsize, size_t maxsize)
 		return 0;
 	}
 
-	import d.gc.capi;
 	import d.gc.tcache;
 	import d.gc.size;
-	auto pd = __sd_gc_maybe_get_page_descriptor(p);
+	// Soft cached lookup: Appender's first growth tries GC.extend on a slab
+	// pointer; a pd-cache hit avoids an uncached radix-tree walk before the 0.
+	auto pd = threadCache.maybeGetPageDescriptorCached(p);
 	auto e = pd.extent;
 	if (e is null || pd.isSlab() || p !is e.address) {
 		return 0;
-- 
